# ===============================================
# PakProperty Frontend Environment Variables
# ===============================================

# Public API URL for client-side queries (leave blank to use relative '/api' proxy)
# NEXT_PUBLIC_API_URL=https://api.pakproperty.com/api

# Internal backend URL for Next.js server-side rewrites and SSR
BACKEND_INTERNAL_URL=http://localhost:5001

# Public site URL for canonical URLs, sitemaps, and OpenGraph tags
NEXT_PUBLIC_SITE_URL=https://pakproperty.com
