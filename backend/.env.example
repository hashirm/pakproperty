# ===============================================
# PakProperty Backend Environment Variables
# ===============================================

# Server Environment
NODE_ENV=production
PORT=5001

# MongoDB Connection String (MongoDB Atlas or self-hosted)
# If omitted in dev/test, an in-memory MongoDB will run as fallback
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pakproperty?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random 64-char key in production)
JWT_SECRET=pakproperty_production_super_secret_jwt_key_2026_change_in_prod

# Allowed CORS Origins (comma-separated without trailing slash)
CORS_ORIGIN=https://pakproperty.com,https://www.pakproperty.com,http://localhost:3000

# Cloudinary Storage for Property Images (Optional - local fallback used if unset)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Auto-seed database with Pakistani demo data on startup (true / false)
SEED_ON_START=true
